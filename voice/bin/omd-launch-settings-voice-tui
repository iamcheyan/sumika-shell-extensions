#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

# Use omd-launch-tui from PATH, or fall back to xdg-terminal-exec
if command -v omd-launch-tui >/dev/null 2>&1; then
    exec omd-launch-tui "$SCRIPT_DIR/omd-settings-voice-tui" voice
else
    case "${TERM:-}" in
        foot) exec foot --app-id=org.omd.voice-settings "$SCRIPT_DIR/omd-settings-voice-tui" voice ;;
        kitty) exec kitty --class=org.omd.voice-settings "$SCRIPT_DIR/omd-settings-voice-tui" voice ;;
        *) exec xdg-terminal-exec --app-id=org.omd.voice-settings "$SCRIPT_DIR/omd-settings-voice-tui" voice ;;
    esac
fi
