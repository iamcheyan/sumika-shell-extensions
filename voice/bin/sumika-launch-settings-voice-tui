#!/usr/bin/env bash
# sumika-launch-settings-voice-tui — Launch the voice settings TUI.
#
# Delegates to the unified sumika-launch-tui: the app-id is derived from the
# TUI filename (io.github.iamcheyan.sumika.sumikasettingsvoicetui) and the
# terminal fallback chain exists in exactly one place.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TUI="${SCRIPT_DIR}/sumika-settings-voice-tui"

if [[ ! -f "$TUI" ]]; then
  echo "sumika-settings-voice-tui not found at $TUI" >&2
  exit 1
fi

if _launcher="$(command -v sumika-launch-tui)"; then
  exec "$_launcher" "$TUI" "${@:2}"
fi

_root="${SUMIKA_SHELL_ROOT:-}"
if [[ -n "$_root" && -x "${_root}/bin/sumika-launch-tui" ]]; then
  exec "${_root}/bin/sumika-launch-tui" "$TUI" "${@:2}"
fi

echo "sumika-launch-tui not found (is SUMIKA_SHELL_ROOT set?)" >&2
exit 127
