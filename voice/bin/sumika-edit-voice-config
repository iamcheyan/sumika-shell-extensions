#!/usr/bin/env bash
set -euo pipefail

config_home="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
config_file="$config_home/voice/config.json"
helper="$(dirname "${BASH_SOURCE[0]}")/sumika-voice-translate"

mkdir -p "$(dirname "$config_file")"
if [[ ! -f "$config_file" ]]; then
  "$helper" set-bindings --translation-binding HANGUL "ALT + A" "code:472" >/dev/null
fi

# 解析真实编辑器。lab/CI 环境会把 EDITOR/VISUAL 设成 true 之类的占位值，
# 直接传给终端会变成 no-op（`true config.json` 立即退出），必须过滤并回退。
resolve_editor() {
  local cand
  for cand in "${VISUAL:-}" "${EDITOR:-}"; do
    [[ -z "$cand" ]] && continue
    case "$cand" in
      true|false|:|/bin/true|/usr/bin/true) continue ;;
    esac
    if command -v "${cand%% *}" >/dev/null 2>&1; then
      printf '%s' "$cand"
      return 0
    fi
  done
  for cand in nvim vim vi; do
    if command -v "$cand" >/dev/null 2>&1; then
      printf '%s' "$cand"
      return 0
    fi
  done
  printf 'vi'
}

editor="$(resolve_editor)"

xdg-terminal-exec \
  --app-id=io.github.iamcheyan.sumika.editvoiceconfig \
  "$editor" "$config_file"

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload >/dev/null 2>&1 || true
fi
