#!/usr/bin/env python3

"""Start a safe speculative translation after live-recording silence.

The result is only a candidate. VoiceInput.qml compares the candidate's
Chinese source with the final SenseVoice result and accepts it only on an
exact match.
"""

from __future__ import annotations

from array import array
import argparse
from collections import deque
import json
import math
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time
import wave


SAMPLE_RATE = 16_000
SAMPLE_WIDTH = 2
WINDOW_MS = 100
MIN_AUDIO_MS = 800
SILENCE_WINDOWS = 5
MIN_SPEECH_RMS = 12
ABSOLUTE_SILENCE_RMS = 8
SILENCE_RATIO = 0.28
POLL_SECONDS = 0.1

child: subprocess.Popen[str] | None = None


def emit(value: dict) -> None:
    print(json.dumps(value, ensure_ascii=False), flush=True)


def terminate_child(_signum: int, _frame: object) -> None:
    if child is not None and child.poll() is None:
        child.terminate()
        try:
            child.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            child.kill()
    raise SystemExit(0)


def data_offset(raw: bytes) -> int | None:
    if len(raw) < 12 or raw[:4] != b"RIFF" or raw[8:12] != b"WAVE":
        return None
    offset = 12
    while offset + 8 <= len(raw):
        chunk_id = raw[offset : offset + 4]
        size = int.from_bytes(raw[offset + 4 : offset + 8], "little")
        if chunk_id == b"data":
            return offset + 8
        # A growing WAV may advertise an unfinished chunk. Stop instead of
        # seeking beyond the bytes currently available.
        next_offset = offset + 8 + size + (size & 1)
        if next_offset <= offset or next_offset > len(raw):
            return None
        offset = next_offset
    return None


def read_live_pcm(path: Path) -> bytes:
    try:
        raw = path.read_bytes()
    except FileNotFoundError:
        return b""
    offset = data_offset(raw)
    if offset is None:
        return b""
    pcm = raw[offset:]
    return pcm[: len(pcm) - (len(pcm) % SAMPLE_WIDTH)]


def rms(window: bytes) -> float:
    samples = array("h")
    samples.frombytes(window)
    if sys.byteorder != "little":
        samples.byteswap()
    if not samples:
        return 0
    return math.sqrt(sum(sample * sample for sample in samples) / len(samples))


def recorder_alive(pid_path: Path) -> bool:
    try:
        pid = int(pid_path.read_text(encoding="utf-8").strip())
        os.kill(pid, 0)
        return True
    except (FileNotFoundError, ProcessLookupError, PermissionError, ValueError):
        return False


def snapshot(pcm: bytes) -> Path:
    fd, name = tempfile.mkstemp(prefix="sumika-voice-speculative-", suffix=".wav")
    os.close(fd)
    path = Path(name)
    with wave.open(str(path), "wb") as output:
        output.setnchannels(1)
        output.setsampwidth(SAMPLE_WIDTH)
        output.setframerate(SAMPLE_RATE)
        output.writeframes(pcm)
    return path


def run_json(command: list[str], stdin: str = "", timeout: int = 60) -> dict:
    global child
    child = subprocess.Popen(
        command,
        stdin=subprocess.PIPE if stdin else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = child.communicate(input=stdin or None, timeout=timeout)
    except subprocess.TimeoutExpired:
        child.kill()
        child.communicate()
        raise RuntimeError(f"{Path(command[0]).name} timed out")
    finally:
        return_code = child.returncode
        child = None
    try:
        result = json.loads(stdout.strip())
    except json.JSONDecodeError as error:
        raise RuntimeError(stderr.strip() or "helper returned invalid JSON") from error
    if return_code != 0 or not isinstance(result, dict):
        raise RuntimeError(
            str(result.get("error", "") if isinstance(result, dict) else "")
            or stderr.strip()
            or f"{Path(command[0]).name} failed"
        )
    return result


def resumed_speech(pcm: bytes, start: int, threshold: float) -> bool:
    bytes_per_window = SAMPLE_RATE * SAMPLE_WIDTH * WINDOW_MS // 1000
    new_audio = pcm[start:]
    return any(
        rms(new_audio[index : index + bytes_per_window]) > threshold
        for index in range(
            0,
            len(new_audio) - bytes_per_window + 1,
            bytes_per_window,
        )
    )


def translate_monitored(
    command: list[str],
    source: str,
    wav_path: Path,
    pid_path: Path,
    baseline_bytes: int,
    resume_threshold: float,
) -> dict | None:
    global child
    child = subprocess.Popen(
        command,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    assert child.stdin is not None
    child.stdin.write(source)
    child.stdin.close()
    child.stdin = None
    started = time.monotonic()
    try:
        while child.poll() is None:
            if time.monotonic() - started > 50:
                child.kill()
                raise RuntimeError(f"{Path(command[0]).name} timed out")
            if recorder_alive(pid_path):
                current_pcm = read_live_pcm(wav_path)
                if resumed_speech(current_pcm, baseline_bytes, resume_threshold):
                    child.terminate()
                    try:
                        child.wait(timeout=0.5)
                    except subprocess.TimeoutExpired:
                        child.kill()
                    return None
            time.sleep(POLL_SECONDS)

        assert child.stdout is not None
        assert child.stderr is not None
        stdout = child.stdout.read()
        stderr = child.stderr.read()
        return_code = child.returncode
    finally:
        child = None

    try:
        result = json.loads(stdout.strip())
    except json.JSONDecodeError as error:
        raise RuntimeError(stderr.strip() or "helper returned invalid JSON") from error
    if return_code != 0 or not isinstance(result, dict):
        raise RuntimeError(
            str(result.get("error", "") if isinstance(result, dict) else "")
            or stderr.strip()
            or f"{Path(command[0]).name} failed"
        )
    return result


def wait_for_silence(wav_path: Path, pid_path: Path) -> tuple[bytes, int, float]:
    bytes_per_window = SAMPLE_RATE * SAMPLE_WIDTH * WINDOW_MS // 1000
    maximum_rms = 0.0
    processed_windows = 0
    trailing_levels: deque[float] = deque(maxlen=SILENCE_WINDOWS)
    saw_recorder = False
    started = time.monotonic()

    while time.monotonic() - started < 95:
        alive = recorder_alive(pid_path)
        saw_recorder = saw_recorder or alive
        if saw_recorder and not alive:
            raise RuntimeError("recording-ended-before-speculation")

        pcm = read_live_pcm(wav_path)
        audio_ms = len(pcm) * 1000 // (SAMPLE_RATE * SAMPLE_WIDTH)
        if audio_ms >= MIN_AUDIO_MS and len(pcm) >= bytes_per_window:
            total_windows = len(pcm) // bytes_per_window
            for window_index in range(processed_windows, total_windows):
                offset = window_index * bytes_per_window
                level = rms(pcm[offset : offset + bytes_per_window])
                maximum_rms = max(maximum_rms, level)
                trailing_levels.append(level)
            processed_windows = total_windows
            silence_limit = max(
                ABSOLUTE_SILENCE_RMS,
                maximum_rms * SILENCE_RATIO,
            )
            if (
                maximum_rms >= MIN_SPEECH_RMS
                and len(trailing_levels) >= SILENCE_WINDOWS
                and all(level <= silence_limit for level in trailing_levels)
            ):
                resume_threshold = max(
                    MIN_SPEECH_RMS,
                    maximum_rms * SILENCE_RATIO * 1.25,
                )
                return pcm, audio_ms, resume_threshold
        time.sleep(POLL_SECONDS)
    raise RuntimeError("speculation-timeout")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("wav_path", type=Path)
    parser.add_argument("--pid-path", type=Path, required=True)
    parser.add_argument("--transcribe-helper", type=Path, required=True)
    parser.add_argument("--translate-helper", type=Path, required=True)
    args = parser.parse_args()

    try:
        while True:
            pcm, audio_ms, resume_threshold = wait_for_silence(
                args.wav_path,
                args.pid_path,
            )
            wav_snapshot = snapshot(pcm)
            try:
                transcribe_started = time.monotonic()
                transcription = run_json(
                    [str(args.transcribe_helper), str(wav_snapshot)],
                    timeout=35,
                )
                transcribe_ms = round(
                    (time.monotonic() - transcribe_started) * 1000
                )
            finally:
                wav_snapshot.unlink(missing_ok=True)

            source = str(transcription.get("text", "")).strip()
            if not source:
                raise RuntimeError("speculative transcription was empty")

            current_pcm = read_live_pcm(args.wav_path)
            if recorder_alive(args.pid_path) and resumed_speech(
                current_pcm,
                len(pcm),
                resume_threshold,
            ):
                continue

            translation_started_at_ms = round(time.time() * 1000)
            emit(
                {
                    "event": "source",
                    "source": source,
                    "audioMs": audio_ms,
                    "transcribeMs": transcribe_ms,
                    "translationStartedAtMs": translation_started_at_ms,
                }
            )

            translate_started = time.monotonic()
            translation = translate_monitored(
                [str(args.translate_helper), "translate-speculative"],
                source,
                args.wav_path,
                args.pid_path,
                len(pcm),
                resume_threshold,
            )
            if translation is None:
                emit({"event": "invalidated", "source": source})
                continue

            translate_ms = round((time.monotonic() - translate_started) * 1000)
            invalidated = False
            while recorder_alive(args.pid_path):
                current_pcm = read_live_pcm(args.wav_path)
                if resumed_speech(
                    current_pcm,
                    len(pcm),
                    resume_threshold,
                ):
                    emit({"event": "invalidated", "source": source})
                    invalidated = True
                    break
                time.sleep(POLL_SECONDS)
            if invalidated:
                continue

            translated = str(translation.get("text", "")).strip()
            if not translated:
                raise RuntimeError("speculative translation was empty")
            emit(
                {
                    "event": "result",
                    "source": source,
                    "text": translated,
                    "audioMs": audio_ms,
                    "transcribeMs": transcribe_ms,
                    "translateMs": translate_ms,
                    "apiSeconds": translation.get("elapsedSeconds", 0),
                    "translationStartedAtMs": translation_started_at_ms,
                }
            )
            return 0
    except RuntimeError as error:
        # Ending recording before a silence candidate is normal, not a user
        # visible translation failure.
        emit({"event": "aborted", "error": str(error)})
        return 0


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, terminate_child)
    signal.signal(signal.SIGINT, terminate_child)
    raise SystemExit(main())
