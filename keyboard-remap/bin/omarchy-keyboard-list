#!/usr/bin/env python3
# List keyboards visible to Hyprland with optional keyd vendor:product IDs.
# A device is considered a keyboard if its input handlers include "leds"
# (meaning the kernel recognizes it as a keyboard with LED indicators)
# AND it has a KEY capability bitmap with letter keys.

import json
import re
import subprocess
import sys

def normalize_slug(name):
    name = name.lower()
    name = re.sub(r'[^a-z0-9]+', '-', name)
    return name.strip('-')

def parse_input_devices():
    """Parse /proc/bus/input/devices into a list of device dicts."""
    devices = []
    current = {}
    try:
        with open('/proc/bus/input/devices', 'r') as f:
            for line in f:
                line = line.strip()
                if not line:
                    if current:
                        devices.append(current)
                        current = {}
                    continue

                prefix = line[:2]
                if prefix == 'I:':
                    vendor_match = re.search(r'Vendor=([0-9a-fA-F]+)', line)
                    product_match = re.search(r'Product=([0-9a-fA-F]+)', line)
                    if vendor_match:
                        current['vendor'] = vendor_match.group(1).lower()
                    if product_match:
                        current['product'] = product_match.group(1).lower()
                elif prefix == 'N:':
                    name_match = re.search(r'Name="([^"]+)"', line)
                    if name_match:
                        current['name'] = name_match.group(1)
                elif prefix == 'H:':
                    current['handlers'] = line
                elif prefix == 'B:' and 'KEY=' in line:
                    flat_hex = line.split('KEY=')[1].replace(' ', '')
                    try:
                        current['key_val'] = int(flat_hex, 16)
                    except ValueError:
                        pass
        if current:
            devices.append(current)
    except Exception:
        pass
    return devices

def is_real_keyboard(dev, all_devices=None):
    """Determine if an input device is a real keyboard.

    Heuristics (all must pass):
    1. Handlers include "kbd" and "leds" (kernel sees it as a keyboard with LEDs)
    2. KEY bitmap includes letter keys (bit 30 = 'a') and ESC (bit 1)
    3. Does NOT have a mouse handler itself
    4. If it is a combo receiver's keyboard interface and the same
       vendor:product also exposes a live pointer interface, the receiver
       is driving a mouse — its (unused) keyboard interface is not a
       keyboard the user can remap, so it is excluded.
    """
    handlers = dev.get('handlers', '')
    key_val = dev.get('key_val', 0)
    has_kbd = 'kbd' in handlers
    has_leds = 'leds' in handlers
    has_mouse = 'mouse' in handlers
    has_esc = bool(key_val & (1 << 1))
    has_letter = bool(key_val & (1 << 30))
    vp = f"{dev.get('vendor', '')}:{dev.get('product', '')}"
    if not (has_kbd and has_leds and not has_mouse and has_esc and has_letter):
        return False
    if all_devices is not None and is_pointer_receiver(dev, all_devices):
        return False
    return True

def is_pointer_receiver(dev, all_devices):
    """True when dev is the keyboard interface of a combo receiver whose
    only active peer is a pointer: no separate real keyboard exists for the
    same vendor:product. Such receivers always enumerate a keyboard HID
    interface even when the paired device is a mouse."""
    vp = f"{dev.get('vendor', '')}:{dev.get('product', '')}"
    if not vp or vp == ':':
        return False
    has_pointer = False
    has_other_keyboard = False
    for other in all_devices:
        if other is dev:
            continue
        other_vp = f"{other.get('vendor', '')}:{other.get('product', '')}"
        if other_vp != vp:
            continue
        other_handlers = other.get('handlers', '')
        if 'mouse' in other_handlers or 'pointercal' in other_handlers:
            # A pointer interface on the same receiver. Media/system-control
            # interfaces of combo receivers also grab a mouse minor by
            # default, but those carry no kbd handler — only a genuine
            # pointer interface does.
            if 'kbd' not in other_handlers:
                has_pointer = True
        elif 'kbd' in other_handlers and 'leds' in other_handlers:
            kv = other.get('key_val', 0)
            if kv & (1 << 1) and kv & (1 << 30):
                has_other_keyboard = True
    return has_pointer and not has_other_keyboard

def lookup_keyd_id(hypr_slug, parsed_devices):
    """Match a Hyprland keyboard slug to a /proc/bus/input/devices entry
    by name similarity, returning the vendor:product ID."""
    best_vendor, best_product = '', ''
    best_score = 0

    for dev in parsed_devices:
        if not is_real_keyboard(dev, parsed_devices):
            continue
        name = dev.get('name', '')
        vendor = dev.get('vendor', '')
        product = dev.get('product', '')
        if not (name and vendor and product):
            continue

        slug = normalize_slug(name)
        score = 0
        if slug == hypr_slug:
            score = 3
        elif slug in hypr_slug or hypr_slug in slug:
            score = 2

        if score > best_score:
            best_score = score
            best_vendor = vendor
            best_product = product

    if best_score > 0:
        return f"{best_vendor}:{best_product}"
    return ""

def is_probable_keyboard(name, main):
    """Pre-filter Hyprland's keyboard list to exclude obvious non-keyboards
    before doing the expensive /proc/bus/input/devices lookup."""
    slug = normalize_slug(name)

    negatives = [
        'audio', 'sound', 'headset', 'headphone', 'microphone', 'speaker',
        'mouse', 'pointer', 'trackpad', 'touchpad', 'consumer-control',
        'system-control', 'virtual-keyboard', 'fcitx',
        'video-bus', 'intel-hid', 'button-array', 'laptop-support',
        'power-button', 'sleep-button', 'wacom', 'tablet',
        'keyd-virtual',
    ]
    if any(neg in slug for neg in negatives):
        return False
    return True

def list_from_proc():
    """Fallback for non-Hyprland sessions (labwc/sway/gnome): scan
    /proc/bus/input/devices directly. Hyprland's main/layout metadata is
    unavailable, so those fields are empty; keydId comes straight from the
    vendor:product of each real keyboard."""
    results = []
    parsed = parse_input_devices()
    for dev in parsed:
        if not is_real_keyboard(dev, parsed):
            continue
        name = dev.get('name', '')
        if not name:
            continue
        if not is_probable_keyboard(name, False):
            continue
        vendor = dev.get('vendor', '')
        product = dev.get('product', '')
        if not (vendor and product):
            continue
        slug = normalize_slug(name)
        is_main = slug == 'at-translated-set-2-keyboard' or (
            len(results) == 0
        )
        results.append({
            'hyprName': slug,
            'rawName': name,
            'displayName': name.strip('- ').replace('-', ' '),
            'keydId': f"{vendor}:{product}",
            'layout': '',
            'main': is_main
        })
    return results

def main():
    try:
        res = subprocess.run(['hyprctl', '-j', 'devices'], capture_output=True, text=True, timeout=5)
        data = json.loads(res.stdout)
        keyboards = data.get('keyboards', [])
        if not keyboards:
            # hyprctl answered but reported no keyboards — fall through
            raise ValueError("no keyboards from hyprctl")
    except Exception:
        # No Hyprland IPC (labwc, sway, GNOME, …) — enumerate from /proc.
        print(json.dumps(list_from_proc()))
        sys.exit(0)

    parsed_devices = parse_input_devices()

    results = []
    for kb in keyboards:
        name = kb.get('name')
        if not name:
            continue
        main_flag = kb.get('main', False)
        if not is_probable_keyboard(name, main_flag):
            continue

        slug = normalize_slug(name)
        keyd_id = lookup_keyd_id(slug, parsed_devices)

        # Skip devices without a keyd ID — they can't be remapped.
        # This filters out mouse-only receivers that Hyprland lists
        # under keyboards (for their media-key interface) but have no
        # real keyboard LED interface in /proc/bus/input/devices.
        if not keyd_id:
            continue

        display_name = name.strip('- ').replace('-', ' ')

        is_main = slug == 'at-translated-set-2-keyboard' or (
            main_flag and 'keyd-virtual' not in slug
        )

        results.append({
            'hyprName': slug,
            'rawName': name,
            'displayName': display_name,
            'keydId': keyd_id,
            'layout': kb.get('layout', ''),
            'main': is_main
        })

    print(json.dumps(results))

if __name__ == '__main__':
    main()
