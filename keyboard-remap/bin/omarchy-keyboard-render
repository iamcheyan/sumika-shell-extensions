#!/usr/bin/env bash
# Render keyd config from Sumika Shell keyboard-remap profiles.
set -eu

SUMIKA_SHELL_ROOT="${SUMIKA_SHELL_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)}"
SUMIKA_CONFIG="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
PROFILES="${SUMIKA_CONFIG}/keyboard-remap/profiles.json"
# Legacy layout: derive from BASH_SOURCE, not the session-wide
# SUMIKA_SHELL_ROOT (which points at the core repo, not this extension).
PROFILES_LEGACY="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)/keyboard-remap/profiles.json"
LIST_KEYBOARDS="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/omarchy-keyboard-list"

# Fall back to legacy path
if [[ ! -f "$PROFILES" && -f "$PROFILES_LEGACY" ]]; then
    PROFILES="$PROFILES_LEGACY"
fi

mkdir -p "$(dirname "$PROFILES")"
if [[ ! -f "$PROFILES" ]]; then
    echo '{"version":1,"devices":{}}' >"$PROFILES"
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: jq is required" >&2
    exit 1
fi

CONNECTED_JSON="$("$LIST_KEYBOARDS" 2>/dev/null || printf '[]')"

# Sasayaki voice-input wake (optional integration, absent = plain swap):
# when CapsLock wake is enabled and this device swaps ctrl<->capslock, the
# caps-position key is rendered as overload(control, f24) — hold stays
# Ctrl (chords unaffected), a bare tap emits F24 which Hyprland binds to
# the voice toggle. Without sasayaki or with wake off, output is identical
# to the plain swap, so the preset keeps working standalone everywhere.
SASAYAKI_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/sasayaki/config.json"
CAPS_WAKE=false
if [[ -f "$SASAYAKI_CFG" ]]; then
    CAPS_WAKE=$(jq -r 'if (.wake_keys.capslock // .caps_lock_wake // false) then "true" else "false" end' "$SASAYAKI_CFG" 2>/dev/null || echo false)
fi

{
    echo "# Generated by Sumika Shell keyboard-remap — do not edit manually"
    echo "# Source: ~/.config/sumika-shell/keyboard-remap/profiles.json"
    echo "# Only currently connected keyboards are emitted; saved disconnected profiles are kept as drafts."
    echo

    jq -r --arg caps_wake "$CAPS_WAKE" --argjson connected "$CONNECTED_JSON" '
        def device_identity:
          ascii_downcase | sub("-keyboard$"; "");

        ($connected | map({key: (.hyprName | device_identity), value: .}) | from_entries) as $connectedByIdentity |

        def preset_remaps($id; $overrides):
          # Get base remaps, then apply per-device overrides for remap-type presets
          (
            if $id == "alt-win-swap" then
              [
                {"from":"leftalt","to":"leftmeta"},
                {"from":"leftmeta","to":"leftalt"}
              ]
            elif $id == "ctrl-caps-swap" then
              [
                {"from":"leftcontrol","to":"capslock"},
                {"from":"capslock","to":
                  (if $caps_wake == "true" then "overload(control, f24)" else "leftcontrol" end)}
              ]
            elif $id == "grave-esc-swap" then
              [
                {"from":"grave","to":"escape"},
                {"from":"escape","to":"grave"}
              ]
            elif $id == "caps-esc" then
              [{"from":"capslock","to":"escape"}]
            elif $id == "muhenkan-meta" then
              [{"from":"muhenkan","to":"leftmeta"}]
            elif $id == "meta-f13" then
              [{"from":"leftmeta","to":"f13"}]
            elif $id == "kana-left" then
              [{"from":"katakanahiragana","to":"left"}]
            elif $id == "rightalt-down" then
              [{"from":"rightalt","to":"down"}]
            elif $id == "rightmeta-down" then
              [{"from":"rightmeta","to":"down"}]
            elif $id == "delete-right" then
              [{"from":"delete","to":"right"}]
            elif $id == "rightctrl-up" then
              [{"from":"rightcontrol","to":"up"}]
            else
              []
            end
          ) | map(
            if (["caps-esc", "muhenkan-meta", "meta-f13", "kana-left", "rightalt-down", "rightmeta-down", "delete-right", "rightctrl-up"] | index($id))
               and (($overrides[$id] // "") | length > 0) then
              . + {"to": $overrides[$id]}
            else . end
          );

        def clean_remaps($rows):
          reduce (($rows // []) | map(select(.from and .to))[]) as $row
            ({}; .[$row.from] = $row.to)
          | to_entries
          | map({"from": .key, "to": .value});

        def preset_rows($ids; $overrides):
          # An override is an explicit user configuration: it implies the
          # preset is active even if it was never toggled on in the UI.
          (($ids // []) + (($overrides // {}) | keys)) | unique
          | map(preset_remaps(.; $overrides)) | add // [];

        .devices
        | to_entries[]
        | . as $dev
        | ($connectedByIdentity[($dev.value.hyprName | device_identity)] // null) as $connectedDevice
        | select($connectedDevice != null)
        | select(.value.enabled != false)
        | ($dev.value.enabledPresets // []) as $deviceEnabled
        | ($dev.value.presetOverrides // {}) as $overrides
        | preset_rows($deviceEnabled; $overrides) as $deviceRemaps
        | clean_remaps($deviceRemaps) as $remaps
        | select($remaps | length > 0)
        | ($connectedDevice.keydId // $dev.value.keydId // "") as $id
        | if ($id | length) > 0 then
            "[ids]\nk:" + $id + "\n\n[main]\n"
            + ($remaps
                | map(.from + " = " + .to)
                | join("\n"))
            + "\n"
          else
            "## WARN: device \($dev.key) has presets but no keydId — skipped\n"
          end
    ' "$PROFILES"
} | perl -0pe 's/\n+\z/\n/'
