#!/usr/bin/env bash
# sumika-launch-keyboard-tui — Launch the keyboard remap settings TUI
# Follows the same unified TUI framework as wifi/bluetooth.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
KEYBOARD_TUI="${SCRIPT_DIR}/sumika-settings-keyboard-tui"

if [[ ! -f "$KEYBOARD_TUI" ]]; then
  echo "sumika-settings-keyboard-tui not found at $KEYBOARD_TUI" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 not found" >&2
  exit 1
fi

run_tui() {
  exec python3 "$KEYBOARD_TUI"
}

# Prefer xdg-terminal-exec with a dedicated app-id for Hyprland floating rules.
if command -v uwsm-app >/dev/null 2>&1 && command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec setsid uwsm-app -- xdg-terminal-exec --app-id=io.github.iamcheyan.sumika.keyboardtui -e python3 "$KEYBOARD_TUI"
fi

if command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec xdg-terminal-exec --app-id=io.github.iamcheyan.sumika.keyboardtui -e python3 "$KEYBOARD_TUI"
fi

# foot / kitty / alacritty / gnome-terminal / konsole fallbacks
for term in foot kitty alacritty gnome-terminal konsole; do
  if command -v "$term" >/dev/null 2>&1; then
    case "$term" in
      gnome-terminal) exec gnome-terminal -- python3 "$KEYBOARD_TUI" ;;
      konsole)        exec konsole -e python3 "$KEYBOARD_TUI" ;;
      *)              exec "$term" -e python3 "$KEYBOARD_TUI" ;;
    esac
  fi
done

run_tui
