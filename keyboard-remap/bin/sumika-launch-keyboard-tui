#!/usr/bin/env bash
# sumika-launch-keyboard-tui — Launch the keyboard remap settings TUI.
#
# Delegates to the unified sumika-launch-tui: the app-id is derived from the
# TUI filename (io.github.iamcheyan.sumika.sumikasettingskeyboardtui) and the
# terminal fallback chain exists in exactly one place. Do not hand-roll
# another fallback chain with a hardcoded app-id here.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TUI="${SCRIPT_DIR}/sumika-settings-keyboard-tui"

if [[ ! -f "$TUI" ]]; then
  echo "sumika-settings-keyboard-tui not found at $TUI" >&2
  exit 1
fi

if _launcher="$(command -v sumika-launch-tui)"; then
  exec "$_launcher" "$TUI"
fi

# Fallback when the repo bin/ is not on PATH (e.g. minimal bind environment).
_root="${SUMIKA_SHELL_ROOT:-}"
if [[ -n "$_root" && -x "${_root}/bin/sumika-launch-tui" ]]; then
  exec "${_root}/bin/sumika-launch-tui" "$TUI"
fi

echo "sumika-launch-tui not found (is SUMIKA_SHELL_ROOT set?)" >&2
exit 127
