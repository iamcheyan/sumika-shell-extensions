// Allow trusted local users to run mount.cifs / umount without a password.
//
// Match the exact executable requested through pkexec, never a substring in
// an attacker-controlled shell command line.

var SUMIKA_PROGRAMS = [
    "/usr/bin/mount.cifs",
    "/usr/sbin/mount.cifs",
    "/sbin/mount.cifs",
    "/bin/mount.cifs",
    "/usr/bin/umount",
    "/bin/umount"
];

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec") {
        return polkit.Result.NOT_HANDLED;
    }

    var program = action.lookup("program");
    if (!program || SUMIKA_PROGRAMS.indexOf(program) === -1) {
        return polkit.Result.NOT_HANDLED;
    }

    var command = action.lookup("command_line");
    if (!command || command.split(" ")[0] !== program) {
        return polkit.Result.NOT_HANDLED;
    }

    if (!subject.active) {
        return polkit.Result.NOT_HANDLED;
    }

    if (!subject.isInGroup("wheel") && !subject.isInGroup("sumika")) {
        return polkit.Result.NOT_HANDLED;
    }

    return polkit.Result.YES;
});
