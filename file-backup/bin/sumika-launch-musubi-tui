#!/usr/bin/env bash
# sumika-launch-musubi-tui — Launch the Musubi file-backup TUI in a terminal.
#
# Delegates to the unified sumika-launch-tui. Musubi is a standalone program
# with its own app-id namespace (io.github.iamcheyan.musubi, registered in
# hypr/looknfeel.lua), so the id is passed explicitly with -a. Terminal
# selection, uwsm wrapping and fallbacks live only in the shared launcher —
# musubi gets exactly the same behavior (and labwc quirks) as every other TUI.
set -euo pipefail

MUSUBI_BIN="$(command -v musubi 2>/dev/null || true)"
if [[ -z "$MUSUBI_BIN" ]]; then
  MUSUBI_BIN="${HOME}/.local/bin/musubi"
fi
if [[ ! -x "$MUSUBI_BIN" ]]; then
  echo "musubi binary not found at $MUSUBI_BIN" >&2
  exit 1
fi

if _launcher="$(command -v sumika-launch-tui)"; then
  exec "$_launcher" -a io.github.iamcheyan.musubi "$MUSUBI_BIN"
fi

_root="${SUMIKA_SHELL_ROOT:-}"
if [[ -n "$_root" && -x "${_root}/bin/sumika-launch-tui" ]]; then
  exec "${_root}/bin/sumika-launch-tui" -a io.github.iamcheyan.musubi "$MUSUBI_BIN"
fi

echo "sumika-launch-tui not found (is SUMIKA_SHELL_ROOT set?)" >&2
exit 127
