#!/usr/bin/env bash
# sumika-launch-ocr-tui — Launch the Sumika Shell OCR setup TUI.
#
# Delegates to the unified sumika-launch-tui: the app-id is derived from the
# TUI filename (io.github.iamcheyan.sumika.sumikaocrtui) and the terminal
# fallback chain exists in exactly one place.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TUI="${SCRIPT_DIR}/sumika-ocr-tui"

if [[ ! -f "$TUI" ]]; then
  echo "sumika-ocr-tui not found at $TUI" >&2
  exit 1
fi

if _launcher="$(command -v sumika-launch-tui)"; then
  exec "$_launcher" "$TUI"
fi

_root="${SUMIKA_SHELL_ROOT:-}"
if [[ -n "$_root" && -x "${_root}/bin/sumika-launch-tui" ]]; then
  exec "${_root}/bin/sumika-launch-tui" "$TUI"
fi

echo "sumika-launch-tui not found (is SUMIKA_SHELL_ROOT set?)" >&2
exit 127
