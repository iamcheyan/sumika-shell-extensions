#!/usr/bin/env python3
"""
Sumika Shell OCR Setup TUI — multi-language OCR installer and configurator.

Installs paddleocr + onnxruntime, downloads selected language models,
and writes the configuration to sumika.json.

Controls
  j / Down      Move selection down
  k / Up        Move selection up
  Space         Toggle language selection
  d / Enter     Set highlighted language as default
  i / I         Install selected languages + download models
  r / R         Force reinstall paddleocr + download models
  s / S         Save config only
  q / Esc       Quit
"""

import curses
import json
import os
import subprocess
import sys
import threading

# ── Framework setup ─────────────────────────────────────────────────────
_omd_bin = os.path.join(
    os.environ.get("SUMIKA_SHELL_ROOT") or os.environ.get("SUMIKA_SHELL_ROOT")
    or os.path.expanduser("~/.config/sumika-shell"), "bin")
if _omd_bin not in sys.path:
    sys.path.insert(0, _omd_bin)
import sumika_tui_framework as S

# ── Constants ───────────────────────────────────────────────────────────
LANGUAGES = [
    ("ch",    "简体中文",   "Chinese (Simplified)"),
    ("en",    "English",    "English"),
    ("japan", "日本語",         "Japanese"),
    ("korean","한국어",          "Korean"),
    ("fr",    "Français",              "French"),
    ("de",    "Deutsch",    "German"),
    ("es",    "Español",              "Spanish"),
    ("pt",    "Português",             "Portuguese"),
    ("it",    "Italiano",   "Italian"),
    ("ru",    "Русский", "Russian"),
    ("ar",    "العربية", "Arabic"),
]
PADDLEOCR_CODES = {c for c, _, _ in LANGUAGES}


def _config_home():
    return os.environ.get("SUMIKA_SHELL_CONFIG_HOME") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
        "sumika-shell",
    )


def _sumika_json_path():
    return os.path.join(_config_home(), "sumika.json")


def read_config():
    path = _sumika_json_path()
    if not os.path.isfile(path):
        return {"ocr": {}}
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        if "ocr" not in data:
            data["ocr"] = {}
        return data
    except (json.JSONDecodeError, OSError):
        return {"ocr": {}}


def write_config(data):
    path = _sumika_json_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        return True
    except OSError as e:
        return str(e)


def check_paddleocr():
    try:
        import paddleocr  # noqa: F401
        return True
    except ImportError:
        return False


def run_pip_install(log, force=False):
    label = "Force reinstalling" if force else "Installing"
    log.append(f"{label} paddleocr + onnxruntime ...")
    cmd = [sys.executable, "-m", "pip", "install", "paddleocr", "onnxruntime"]
    if force:
        cmd.insert(4, "--force-reinstall")
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
        for line in iter(proc.stdout.readline, ""):
            line = line.rstrip()
            if line:
                log.append(line)
        proc.wait()
        if proc.returncode == 0:
            log.append(("ok", f"{'Reinstall' if force else 'Install'} complete."))
        else:
            log.append(("danger", f"pip install FAILED (exit {proc.returncode})."))
        return proc.returncode == 0
    except Exception as e:
        log.append(("danger", f"pip install error: {e}"))
        return False


def download_model(lang_code, log):
    log.append(f"Downloading {lang_code} model ...")
    py_code = (
        "import os, sys; "
        "os.environ['PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK']='1'; "
        "os.environ['GLOG_minloglevel']='3'; "
        "from paddleocr import PaddleOCR; "
        f"PaddleOCR(lang='{lang_code}', engine='onnxruntime')"
    )
    cmd = [sys.executable, "-c", py_code]
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
        for line in iter(proc.stdout.readline, ""):
            line = line.rstrip()
            if line:
                log.append(f"  {line}")
        proc.wait()
        if proc.returncode == 0:
            log.append(("ok", f"✓ {lang_code} model ready."))
            return True
        else:
            log.append(("danger", f"✗ {lang_code} model FAILED (exit {proc.returncode})."))
            return False
    except Exception as e:
        log.append(("danger", f"✗ {lang_code} model error: {e}"))
        return False


# ── TUI ─────────────────────────────────────────────────────────────────
class OcrModel:
    """Model for the OCR setup TUI — compatible with S.run_tui_loop."""
    dirty = True

    def __init__(self):
        self.config = read_config()
        ocr_cfg = self.config.get("ocr", {})
        self.installed = ocr_cfg.get("languages", [])
        self.default_lang = ocr_cfg.get("lang", "ch")
        self.selected = {c for c in self.installed if c in PADDLEOCR_CODES}
        if not self.selected:
            self.selected = {"ch"}
        if self.default_lang in PADDLEOCR_CODES:
            self.selected.add(self.default_lang)
        self.have_ocr = check_paddleocr()
        self.cursor = 0
        self.busy = False
        self.busy_log: list = []
        self.status_msg = ""
        self.status_tone = "ok"
        self._done_event = threading.Event()
        self._install_ok = [False]

    def start_work(self, force=False):
        self.busy_log.clear()
        self.busy = True
        self.status_msg = ""
        self._done_event.clear()
        self.dirty = True
        lang_codes = sorted(self.selected)
        cfg = {"lang": self.default_lang, "languages": lang_codes, "engine": "onnxruntime"}

        def _work():
            log = self.busy_log
            self._install_ok[0] = True
            if force or not check_paddleocr():
                ok = run_pip_install(log, force=force)
            else:
                log.append("paddleocr package is already installed.")
                ok = True
            if ok:
                for code in lang_codes:
                    if code in PADDLEOCR_CODES:
                        if not download_model(code, log):
                            self._install_ok[0] = False
            log.append("")
            log.append("Saving config...")
            self.config["ocr"] = cfg
            r = write_config(self.config)
            if r is True:
                log.append(("ok", "Config saved to sumika.json"))
            else:
                log.append(("danger", f"WARNING: {r}"))
            self._done_event.set()

        t = threading.Thread(target=_work, daemon=True)
        t.start()

    def check_completion(self):
        """Called via refresh_callback — checks if background work finished."""
        if self.busy and self._done_event.is_set():
            self.busy = False
            self.have_ocr = check_paddleocr()
            if self._install_ok[0]:
                self.status_msg = "Installation & model downloads complete!"
                self.status_tone = "ok"
            else:
                self.status_msg = "Download process encountered issues."
                self.status_tone = "danger"
            self.dirty = True


def _hero_info(m):
    title = "OCR Setup & Model Downloader"
    subtitle_parts = []
    subtitle_parts.append(
        "Installed" if m.have_ocr else "Not installed")
    subtitle_parts.append(f"Default: {m.default_lang}")
    extra = ""
    if m.busy:
        extra = "working..."
    elif m.status_msg:
        extra = m.status_msg
    if extra:
        subtitle_parts.append(extra)
    subtitle = " · ".join(subtitle_parts)
    status_text = ""
    tone = "muted"
    if m.busy:
        status_text = "Working..."
        tone = "warn"
    elif m.have_ocr:
        status_text = "Engine ready"
        tone = "ok"
    else:
        status_text = "Not installed"
        tone = "muted"
    msg = ""
    if m.busy:
        msg = "working..."
    elif m.status_msg:
        msg = m.status_msg
        tone = m.status_tone
    return S.hero_line(title, subtitle, tone, m.busy, msg, status_text)


def _draw_lang_list(stdscr, m, y, x, h, w):
    n = len(LANGUAGES)
    max_vis = min(n, h)
    scroll = max(0, min(m.cursor - max_vis + 1, n - max_vis))

    for i in range(scroll, min(scroll + max_vis, n)):
        code, native, eng = LANGUAGES[i]
        checked = code in m.selected
        is_def = code == m.default_lang
        trailing = "← default" if is_def else ""
        tag, text = S.toggle_line(
            checked, f"{native} ({eng})",
            focused=(i == m.cursor and not m.busy),
            trailing=trailing)
        attr = S.TAG_STYLE.get(tag, S.ATTR_TEXT)
        S.safe_addstr(stdscr, y + (i - scroll), x,
                      S.truncate(text, w), attr)


def _view(stdscr, m):
    h, w = stdscr.getmaxyx()
    stdscr.erase()

    if not S.require_terminal_size(stdscr, 44, 14):
        return

    margin = 1
    hero_h = 2

    # Layout
    log_h = 6 if (m.busy or m.status_msg) else 0
    help_h = 1
    list_h = max(4, h - hero_h - log_h - help_h - margin * 2)

    # ── Hero ──
    S.draw_hero(stdscr, _hero_info(m))

    # ── Language list panel ──
    y = margin + hero_h - 1
    box_w = w - margin * 2
    S.draw_focus_border(stdscr, True, y, margin, list_h, box_w, "Languages")
    _draw_lang_list(stdscr, m, y + 1, margin + 1, list_h - 2, box_w - 2)
    y += list_h

    # ── Log / status panel ──
    if log_h > 0:
        log_y = y
        if m.busy:
            S.draw_border(stdscr, log_y, margin, log_h, box_w, "Activity")
            S.draw_log_in_area(stdscr, log_y, margin, log_h, box_w,
                               m.busy_log, empty_text="Starting...")
        elif m.status_msg:
            S.draw_border(stdscr, log_y, margin, log_h, box_w, "Status")
            ok = m.status_tone == "ok"
            attr = S.ATTR_OK if ok else S.ATTR_DANGER
            S.safe_addstr(
                stdscr, log_y + 1, margin + 2,
                S.truncate(m.status_msg, box_w - 4),
                attr)
        y += log_h

    # ── Help bar ──
    if not m.busy:
        gen = [("arrows", "navigate"), ("q", "quit")]
        tool = [
            ("space", "toggle"), ("d", "default"),
            ("i", "install"), ("r", "reinstall"),
            ("s", "save"),
        ]
    else:
        gen = [("q", "cancel")]
        tool = [("wait..", "installing")]
    S.draw_help_bar(stdscr, gen, tool)

    S.finish_frame(stdscr)


def _handle_key(stdscr, m, key):
    if key in (ord("q"), ord("Q"), 27):
        return False

    if m.busy:
        return True

    n = len(LANGUAGES)

    if key in (ord("j"), ord("J"), curses.KEY_DOWN):
        if m.cursor < n - 1:
            m.cursor += 1
            m.dirty = True
    elif key in (ord("k"), ord("K"), curses.KEY_UP):
        if m.cursor > 0:
            m.cursor -= 1
            m.dirty = True
    elif key == ord(" "):
        code = LANGUAGES[m.cursor][0]
        if code in m.selected:
            m.selected.discard(code)
            if code == m.default_lang and m.selected:
                m.default_lang = next(iter(m.selected))
        else:
            m.selected.add(code)
            m.default_lang = code
        m.status_msg = ""
        m.dirty = True
    elif key in (ord("d"), ord("D"), 10, 13):
        code = LANGUAGES[m.cursor][0]
        m.selected.add(code)
        m.default_lang = code
        m.status_msg = f"Default: {code}"
        m.status_tone = "ok"
        m.dirty = True
    elif key in (ord("i"), ord("I")):
        if not m.selected:
            m.status_msg = "Select at least one language."
            m.status_tone = "danger"
            m.dirty = True
            return True
        m.start_work(force=False)
    elif key in (ord("r"), ord("R")):
        if not m.selected:
            m.status_msg = "Select at least one language."
            m.status_tone = "danger"
            m.dirty = True
            return True
        m.start_work(force=True)
    elif key in (ord("s"), ord("S")):
        if not m.selected:
            m.status_msg = "Select at least one language."
            m.status_tone = "danger"
            m.dirty = True
            return True
        cfg = {
            "lang": m.default_lang,
            "languages": sorted(m.selected),
            "engine": "onnxruntime",
        }
        m.config["ocr"] = cfg
        err = write_config(m.config)
        if err is True:
            m.status_msg = f"✓ Config saved (Default: {m.default_lang})"
            m.status_tone = "ok"
        else:
            m.status_msg = f"✗ Config save failed: {err}"
            m.status_tone = "danger"
        m.dirty = True

    return True


def main():
    S.setup_locale()
    try:
        curses.wrapper(lambda stdscr: S.run_tui_loop(
            stdscr, OcrModel(), _view, _handle_key,
            poll_timeout=150,
            refresh_interval=0.3,
            refresh_callback=lambda m: m.check_completion()
        ))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
