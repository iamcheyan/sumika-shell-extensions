#!/bin/bash
# omarchy:summary=Launch the OMD OCR setup TUI

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
OCR_TUI="${SCRIPT_DIR}/omd-ocr-tui"

if [[ ! -f "$OCR_TUI" ]]; then
  echo "omd-ocr-tui not found at $OCR_TUI" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 not found" >&2
  exit 1
fi

run_tui() {
  exec python3 "$OCR_TUI"
}

if command -v uwsm-app >/dev/null 2>&1 && command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omd.ocr-tui -e python3 "$OCR_TUI"
fi

if command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec xdg-terminal-exec --app-id=org.omd.ocr-tui -e python3 "$OCR_TUI"
fi

# foot / kitty / alacritty / gnome-terminal fallbacks
for term in foot kitty alacritty gnome-terminal konsole; do
  if command -v "$term" >/dev/null 2>&1; then
    case "$term" in
      gnome-terminal) exec gnome-terminal -- python3 "$OCR_TUI" ;;
      konsole)        exec konsole -e python3 "$OCR_TUI" ;;
      *)              exec "$term" -e python3 "$OCR_TUI" ;;
    esac
  fi
done

run_tui
