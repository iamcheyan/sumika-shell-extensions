#!/bin/sh
set -eu

# On-demand Screenshot / Region Selector process.
# Usage:
#   sumika-screenshot              # fast region screenshot (slurp + grim)
#   sumika-screenshot screenshot   # same as above
#   sumika-screenshot fullscreen   # capture the focused/first monitor
#   sumika-screenshot delay        # capture the focused/first monitor after 3s
#   sumika-screenshot edit         # frozen screenshot & edit
#   sumika-screenshot search       # search with Google Lens
#   sumika-screenshot ocr          # OCR text recognition
#   sumika-screenshot record       # record region
#   sumika-screenshot toggle       # open if closed, cancel if already open
#
# Starts a Quickshell process that auto-opens the region selector
# and quits when the selection is complete or cancelled.
# Re-invoking while open cancels the current selection (toggle).

app_dir="$(cd "$(dirname "$0")/.." && pwd)/apps/sumika-screenshot"
log_file="${SUMIKA_SCREENSHOT_LOG:-/tmp/sumika-screenshot.log}"
action="${1:-screenshot}"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/sumika-screenshot.lock"
fast_pid_file="${XDG_RUNTIME_DIR:-/tmp}/sumika-screenshot-fast.pid"
active_flag="${XDG_RUNTIME_DIR:-/tmp}/sumika-screenshot-active"

# Hyprland binds can run with a minimal environment.
if [ -n "${PATH:-}" ]; then
    export PATH="$PATH:/usr/bin:/usr/local/bin:/run/current-system/sw/bin:${HOME}/.local/bin"
else
    export PATH="/usr/bin:/usr/local/bin:/run/current-system/sw/bin:${HOME}/.local/bin"
fi

# Normalize legacy aliases.
case "$action" in
    toggle|"")
        action="screenshot"
        toggle_mode=1
        ;;
    *)
        toggle_mode=0
        ;;
esac

is_running() {
    pgrep -af "(quickshell|qs).* -p ${app_dir}( |$)" >/dev/null 2>&1
}

list_running_pids() {
    pgrep -f "(quickshell|qs).* -p ${app_dir}( |$)" 2>/dev/null || true
}

kill_running() {
    pids=$(list_running_pids)
    if [ -z "${pids:-}" ]; then
        return 0
    fi
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null || true
    i=0
    while is_running && [ "$i" -lt 20 ]; do
        sleep 0.05
        i=$((i + 1))
    done
    if is_running; then
        pids=$(list_running_pids)
        # shellcheck disable=SC2086
        [ -n "${pids:-}" ] && kill -9 $pids 2>/dev/null || true
    fi
}

wait_until_not_running() {
    i=0
    while is_running && [ "$i" -lt 30 ]; do
        sleep 0.05
        i=$((i + 1))
    done
}

wait_until_running_or_failed() {
    i=0
    while [ "$i" -lt 20 ]; do
        if is_running; then
            return 0
        fi
        sleep 0.05
        i=$((i + 1))
    done
    return 1
}

focused_monitor() {
    # Hyprland: query the focused monitor directly.
    if command -v hyprctl >/dev/null 2>&1; then
        mon="$(hyprctl monitors -j 2>/dev/null \
            | jq -r '.[] | select(.focused) | .name' 2>/dev/null \
            | head -n 1)"
        [ -n "$mon" ] && { printf '%s\n' "$mon"; return 0; }
    fi
    # wlroots compositors (labwc): no focused concept in wlr-randr; fall
    # back to the first enabled output. Single-monitor labwc sessions get
    # the exact name; multi-output picks the first enabled, matching the
    # slurp %o geometry the fast-capture path relies on.
    if command -v wlr-randr >/dev/null 2>&1; then
        mon="$(wlr-randr --json 2>/dev/null \
            | jq -r '.[] | select(.enabled) | .name' 2>/dev/null \
            | head -n 1)"
        [ -n "$mon" ] && { printf '%s\n' "$mon"; return 0; }
    fi
    return 0
}

# (Cursor hiding removed — the software cursor is intentionally left
# visible during grim captures. The previous HideCursor / ydotool approach
# could leave the pointer stuck-hidden after a capture on labwc, and
# Hyprland's cursor.invisible was unreliable to save/restore. A visible
# cursor in a screenshot is a minor cosmetic issue; a stuck-hidden cursor
# is a real bug.)

# Resolve the bar app path used for freeze/unfreeze IPC from the live
# session root only. No clone-location guessing: unset means clean failure.
bar_app_path() {
    if [ -n "${SUMIKA_SHELL_ROOT:-}" ] && [ -d "${SUMIKA_SHELL_ROOT}/apps/sumika-bar" ]; then
        printf '%s\n' "${SUMIKA_SHELL_ROOT}/apps/sumika-bar"
        return 0
    fi
    return 1
}

# Hide live bar menus/popups so the selection mask is the topmost surface.
# xdg_popup context menus can stack above Overlay layer shells on Hyprland;
# closing them is required for the darken/selection UI to cover everything.
#
# Timing: call freeze ONLY after the selection overlay is already mapped.
# Freezing first makes the menu vanish into a bright empty frame, then the
# mask pops in — that flash is what users notice. Overlay first, then freeze,
# so the menu disappears *under* the already-present darken mask.
freeze_bar() {
    _bar="$(bar_app_path)" || return 0
    "${SUMIKA_QS_BIN:-qs}" -p "$_bar" ipc call action call screenshot.freeze "" >/dev/null 2>&1 || true
}

unfreeze_bar() {
    _bar="$(bar_app_path)" || return 0
    "${SUMIKA_QS_BIN:-qs}" -p "$_bar" ipc call action call screenshot.unfreeze "" >/dev/null 2>&1 || true
}

# Wait until slurp's layer-shell surface is mapped (namespace "selection"),
# or until the slurp process exits. Caps at ~300ms so we never hang.
wait_for_selection_overlay() {
    _pid="${1:-}"
    i=0
    while [ "$i" -lt 30 ]; do
        if [ -n "$_pid" ] && ! kill -0 "$_pid" 2>/dev/null; then
            return 1
        fi
        if command -v hyprctl >/dev/null 2>&1; then
            if hyprctl layers 2>/dev/null | grep -q 'namespace: selection'; then
                return 0
            fi
        fi
        sleep 0.01
        i=$((i + 1))
    done
    return 1
}

cancel_fast_capture() {
    [ -f "$fast_pid_file" ] || return 1
    fast_pid="$(cat "$fast_pid_file" 2>/dev/null || true)"
    if [ -n "$fast_pid" ] && kill -0 "$fast_pid" 2>/dev/null; then
        kill "$fast_pid" 2>/dev/null || true
        rm -f "$fast_pid_file"
        return 0
    fi
    rm -f "$fast_pid_file"
    return 1
}

fast_capture() {
    # Repeating the shortcut cancels the active slurp selection.
    if cancel_fast_capture; then
        unfreeze_bar
        exit 0
    fi

    if ! command -v slurp >/dev/null 2>&1 || ! command -v grim >/dev/null 2>&1 || ! command -v wl-copy >/dev/null 2>&1; then
        notify-send -u critical "Screenshot" "grim, slurp and wl-copy are required" 2>/dev/null || true
        exit 127
    fi

    target_monitor="$(focused_monitor)"
    selection_file="$(mktemp /tmp/sumika-slurp.XXXXXX)"
    # %W/%H crop the drag geometry to the output containing its top-left
    # corner, so a selection cannot spill into an adjacent monitor.
    # Start slurp FIRST so the darken mask is on screen, then freeze the bar
    # so live menus disappear under the mask (no bright empty flash).
    # Match RegionSelection.overlayColor exactly: 0x80 alpha is 50% black.
    slurp -d -f '%x,%y %Wx%H|%o' \
        -b '#00000080' -c '#f4f4f4ff' -s '#ffffff22' -w 2 \
        > "$selection_file" 2>/dev/null &
    slurp_pid=$!
    printf '%s\n' "$slurp_pid" > "$fast_pid_file"
    trap 'kill "$slurp_pid" 2>/dev/null || true; rm -f "$fast_pid_file" "$selection_file"; unfreeze_bar' EXIT INT TERM
    wait_for_selection_overlay "$slurp_pid" || true
    freeze_bar
    wait "$slurp_pid" 2>/dev/null || true
    rm -f "$fast_pid_file"
    trap 'rm -f "$fast_pid_file" "$selection_file"; unfreeze_bar' EXIT INT TERM
    selection="$(cat "$selection_file" 2>/dev/null || true)"
    rm -f "$selection_file"
    if [ -z "$selection" ]; then
        unfreeze_bar
        trap - EXIT INT TERM
        exit 0
    fi

    geometry="${selection%|*}"
    selected_monitor="${selection##*|}"
    if [ -n "$target_monitor" ] && [ "$selected_monitor" != "$target_monitor" ]; then
        unfreeze_bar
        trap - EXIT INT TERM
        notify-send "Screenshot cancelled" "Select a region on the focused display ($target_monitor)" 2>/dev/null || true
        exit 0
    fi

    tmp_file="$(mktemp /tmp/sumika-screenshot.XXXXXX.png)"
    trap 'rm -f "$fast_pid_file" "$tmp_file"; unfreeze_bar' EXIT INT TERM
    grim -g "$geometry" "$tmp_file"
    unfreeze_bar
    trap 'rm -f "$fast_pid_file" "$tmp_file"' EXIT INT TERM

    save_dir=""
    _sumika_cfg="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
    _cfg_file="$_sumika_cfg/sumika.json"
    [ -f "$_cfg_file" ] || _cfg_file="$HOME/.config/quickshell/config.json"
    if command -v jq >/dev/null 2>&1 && [ -r "$_cfg_file" ]; then
        save_dir="$(jq -r '.screenSnip.savePath // empty' "$_cfg_file" 2>/dev/null || true)"
    fi
    if [ -n "$save_dir" ]; then
        mkdir -p "$save_dir"
        save_path="$save_dir/screenshot-$(date '+%Y-%m-%d_%H.%M.%S').png"
        cp "$tmp_file" "$save_path"
    fi
    cliphist store < "$tmp_file" 2>/dev/null || true
    wl-copy --type image/png < "$tmp_file"
    notify-send -i camera-photo "Screenshot" "Region copied to clipboard" 2>/dev/null || true
}


# Fullscreen / delayed capture of one monitor (focused on Hyprland, first
# enabled on wlroots/labwc). Shares the monitor resolution + clipboard store
# pipeline with fast_capture.
capture_monitor() {
    _delay="${1:-0}"
    if ! command -v grim >/dev/null 2>&1 || ! command -v wl-copy >/dev/null 2>&1; then
        notify-send -u critical "Screenshot" "grim and wl-copy are required" 2>/dev/null || true
        exit 127
    fi

    target_monitor="$(focused_monitor)"
    if [ -z "$target_monitor" ]; then
        notify-send -u critical "Screenshot" "No enabled monitor found" 2>/dev/null || true
        exit 1
    fi

    if [ "$_delay" -gt 0 ]; then
        notify-send -i camera-photo "Screenshot" "Capturing ${target_monitor} in ${_delay}s" 2>/dev/null || true
        sleep "$_delay"
    fi

    tmp_file="$(mktemp /tmp/sumika-screenshot.XXXXXX.png)"
    trap 'rm -f "$tmp_file"' EXIT INT TERM
    grim -o "$target_monitor" "$tmp_file"

    save_dir=""
    _sumika_cfg="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
    _cfg_file="$_sumika_cfg/sumika.json"
    [ -f "$_cfg_file" ] || _cfg_file="$HOME/.config/quickshell/config.json"
    if command -v jq >/dev/null 2>&1 && [ -r "$_cfg_file" ]; then
        save_dir="$(jq -r '.screenSnip.savePath // empty' "$_cfg_file" 2>/dev/null || true)"
    fi
    if [ -n "$save_dir" ]; then
        mkdir -p "$save_dir"
        save_path="$save_dir/screenshot-$(date '+%Y-%m-%d_%H.%M.%S').png"
        cp "$tmp_file" "$save_path"
    fi
    cliphist store < "$tmp_file" 2>/dev/null || true
    wl-copy --type image/png < "$tmp_file"
    rm -f "$tmp_file"
    trap - EXIT INT TERM
    notify-send -i camera-photo "Screenshot" "${target_monitor} copied to clipboard" 2>/dev/null || true
}


# Serialize the critical "kill + relaunch" section so rapid clicks do not
# race each other. The lock is held ONLY for this section, then released before
# launching Quickshell, so wl-copy/grim/hyprpicker never inherit it.
exec 9>"$lock_file"
flock -w 1 9 || exit 0

# Re-press while open = cancel (same mental model as slurp toggle).
if is_running; then
    # A repeat launcher invocation must never act as a stop toggle for an
    # active recording: killing the selector here would let the
    # --stop-with-parent watcher SIGINT wf-recorder. Bail out instead.
    rec_pidfile="${XDG_RUNTIME_DIR:-/tmp}/sumika-record.pid"
    case "$action" in
        record|recordWithSound)
            if [ -f "$rec_pidfile" ] && kill -0 "$(cat "$rec_pidfile" 2>/dev/null)" 2>/dev/null; then
                exec 9>&-
                exit 0
            fi
            ;;
    esac
    kill_running
    wait_until_not_running
    rm -f "$active_flag"
    unfreeze_bar
    # Explicit cancel request: do not relaunch.
    if [ "$toggle_mode" -eq 1 ] || [ "${1:-}" = "toggle" ]; then
        exec 9>&-
        exit 0
    fi
    # Explicit actions from the bar/keybind should be reliable wake requests:
    # clear stale or half-visible instances, then launch a fresh selector.
    sleep 0.1
fi
exec 9>&-

launch_direct() {
    cancel_fast_capture || true

    qs_bin="${SUMIKA_QS_BIN:-}"
    if [ -z "$qs_bin" ]; then
        # Distro layouts: Arch/Omarchy (/usr/bin), user installs (~/.local/bin),
        # NixOS (/run/current-system/sw/bin), then whatever PATH provides.
        for candidate in \
            /usr/bin/qs /usr/bin/quickshell \
            "$HOME/.local/bin/qs" "$HOME/.local/bin/quickshell" \
            /run/current-system/sw/bin/qs /run/current-system/sw/bin/quickshell; do
            if [ -x "$candidate" ]; then
                qs_bin="$candidate"
                break
            fi
        done
    fi
    if [ -z "$qs_bin" ]; then
        qs_bin="$(command -v qs 2>/dev/null || command -v quickshell 2>/dev/null || true)"
    fi
    if [ -z "$qs_bin" ]; then
        echo "Quickshell executable not found" >&2
        exit 127
    fi

    export QS_CONFIG_DIR="$app_dir"
    export QS_COMPOSITOR=hyprland
    export SUMIKA_APP_DIR="$app_dir"
    export SUMIKA_SCREENSHOT_ACTION="$action"

    runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    # Prefer the live Hyprland instance (correct WAYLAND_DISPLAY + signature).
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
        for candidate in "$runtime_dir"/hypr/*/hyprland.lock; do
            [ -f "$candidate" ] || continue
            pid="$(sed -n '1p' "$candidate" 2>/dev/null || true)"
            display="$(sed -n '2p' "$candidate" 2>/dev/null || true)"
            [ -n "$pid" ] || continue
            kill -0 "$pid" 2>/dev/null || continue
            export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$(dirname "$candidate")")"
            [ -n "$display" ] && export WAYLAND_DISPLAY="$display"
            break
        done
    fi

    if [ -z "${WAYLAND_DISPLAY:-}" ] || [ ! -S "$runtime_dir/${WAYLAND_DISPLAY:-}" ]; then
        for socket in "$runtime_dir"/wayland-*; do
            if [ -S "$socket" ]; then
                export WAYLAND_DISPLAY="$(basename "$socket")"
                break
            fi
        done
    fi

    if [ -z "${WAYLAND_DISPLAY:-}" ]; then
        echo "No Wayland display socket found. Start this from inside Hyprland." >&2
        exit 1
    fi

    target_monitor="$(focused_monitor)"
    if [ -n "$target_monitor" ]; then
        export SUMIKA_SCREENSHOT_MONITOR="$target_monitor"
    fi

    # Set flag so the bar knows a screenshot session is active.
    touch "$active_flag"

    snapshot_dir="/tmp/quickshell/media/screenshot"
    mkdir -p "$snapshot_dir"
    export SUMIKA_SNAPSHOT_DIR="$snapshot_dir"

    # Capture the frozen snapshot BEFORE hiding bar popups, so menus and
    # popups present at trigger time are included in the snapshot. Do NOT
    # freeze here — freeze runs inside the region selector AFTER its overlay
    # is visible, so live menus disappear under the frozen image + mask
    # instead of flashing away on a bright empty desktop first.
    if [ "$action" != "record" ] && [ "$action" != "recordWithSound" ]; then
        snapshot_ts="$(date +%s%3N)"
        if [ -n "$target_monitor" ]; then
            snap_path="${snapshot_dir}/snapshot-${target_monitor}-${snapshot_ts}.png"
            if grim -o "$target_monitor" "$snap_path" > /dev/null 2>&1; then
                mon_env="$(printf '%s' "$target_monitor" | sed 's/[-.]/_/g')"
                export "SUMIKA_SNAPSHOT_PATH_${mon_env}=${snap_path}"
            fi
        fi
    fi

    # Tell the selector to freeze the bar once its overlay is mapped.
    export SUMIKA_SCREENSHOT_DEFER_FREEZE=1

    qs_import_root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sumika-shell/qml"
    export QML_IMPORT_PATH="$qs_import_root${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
    nohup "$qs_bin" -p "$app_dir" >> "$log_file" 2>&1 &
    selector_pid=$!
    wait_until_running_or_failed || true
    # When the region selector exits, unfreeze the bar (restore popups) and
    # clear the active flag. Runs detached so this script can return now.
    _bar_app="$(bar_app_path || true)"
    _qs="${SUMIKA_QS_BIN:-qs}"
    if [ -n "${_bar_app:-}" ]; then
        nohup bash -c "
            while kill -0 '$selector_pid' 2>/dev/null; do sleep 0.3; done
            '$_qs' -p '$_bar_app' ipc call action call screenshot.unfreeze '' >/dev/null 2>&1 || true
            rm -f '$active_flag'
        " >/dev/null 2>&1 &
    else
        nohup bash -c "
            while kill -0 '$selector_pid' 2>/dev/null; do sleep 0.3; done
            rm -f '$active_flag'
        " >/dev/null 2>&1 &
    fi
}

case "$action" in
    screenshot)
        fast_capture
        ;;
    fullscreen)
        capture_monitor 0
        ;;
    delay)
        capture_monitor 3
        ;;
    edit|search|ocr|record|recordWithSound)
        # Record uses the same QML selector (mask + region) then a countdown
        # and on-screen stop bar; backend is sumika-record via the QML process.
        # A repeat launcher invocation is never allowed to stop a recording.
        launch_direct
        ;;
    *)
        echo "usage: sumika-screenshot [screenshot|fullscreen|delay|edit|search|ocr|record|recordWithSound|toggle]" >&2
        exit 2
        ;;
esac
