#!/usr/bin/env python3
"""
OMD OCR Setup TUI — multi-language OCR installer and configurator.

Installs paddleocr + onnxruntime, downloads selected language models,
and writes the configuration to sumika.json.

Controls
  j / Down      Move selection down
  k / Up        Move selection up
  Space         Toggle language selection
  d / Enter     Set highlighted language as default
  i / I         Install selected languages + download models
  r / R         Force reinstall paddleocr + download models
  s / S         Save config only
  q / Esc       Quit
"""

import curses
import json
import os
import subprocess
import sys
import threading

# ── Framework setup ─────────────────────────────────────────────────────
_omd_bin = os.path.join(
    os.environ.get("OMD_ROOT") or os.environ.get("SUMIKA_SHELL_ROOT")
    or os.path.expanduser("~/.config/omd"), "bin")
if _omd_bin not in sys.path:
    sys.path.insert(0, _omd_bin)
import omd_tui_framework as S

# ── Constants ───────────────────────────────────────────────────────────
LANGUAGES = [
    ("ch",    "简体中文",   "Chinese (Simplified)"),
    ("en",    "English",    "English"),
    ("japan", "日本語",         "Japanese"),
    ("korean","한국어",          "Korean"),
    ("fr",    "Français",              "French"),
    ("de",    "Deutsch",    "German"),
    ("es",    "Español",              "Spanish"),
    ("pt",    "Português",             "Portuguese"),
    ("it",    "Italiano",   "Italian"),
    ("ru",    "Русский", "Russian"),
    ("ar",    "العربية", "Arabic"),
]
PADDLEOCR_CODES = {c for c, _, _ in LANGUAGES}


def _config_home():
    return os.environ.get("SUMIKA_SHELL_CONFIG_HOME") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
        "sumika-shell",
    )


def _sumika_json_path():
    return os.path.join(_config_home(), "sumika.json")


def read_config():
    path = _sumika_json_path()
    if not os.path.isfile(path):
        return {"ocr": {}}
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        if "ocr" not in data:
            data["ocr"] = {}
        return data
    except (json.JSONDecodeError, OSError):
        return {"ocr": {}}


def write_config(data):
    path = _sumika_json_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        return True
    except OSError as e:
        return str(e)


def check_paddleocr():
    try:
        import paddleocr  # noqa: F401
        return True
    except ImportError:
        return False


def run_pip_install(log, force=False):
    label = "Force reinstalling" if force else "Installing"
    log.append(f"{label} paddleocr + onnxruntime ...")
    cmd = [sys.executable, "-m", "pip", "install", "paddleocr", "onnxruntime"]
    if force:
        cmd.insert(4, "--force-reinstall")
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
        for line in iter(proc.stdout.readline, ""):
            line = line.rstrip()
            if line:
                log.append(line)
        proc.wait()
        if proc.returncode == 0:
            log.append(("ok", f"{'Reinstall' if force else 'Install'} complete."))
        else:
            log.append(("danger", f"pip install FAILED (exit {proc.returncode})."))
        return proc.returncode == 0
    except Exception as e:
        log.append(("danger", f"pip install error: {e}"))
        return False


def download_model(lang_code, log):
    log.append(f"Downloading {lang_code} model ...")
    py_code = (
        "import os, sys; "
        "os.environ['PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK']='1'; "
        "os.environ['GLOG_minloglevel']='3'; "
        "from paddleocr import PaddleOCR; "
        f"PaddleOCR(lang='{lang_code}', engine='onnxruntime')"
    )
    cmd = [sys.executable, "-c", py_code]
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
        for line in iter(proc.stdout.readline, ""):
            line = line.rstrip()
            if line:
                log.append(f"  {line}")
        proc.wait()
        if proc.returncode == 0:
            log.append(("ok", f"✓ {lang_code} model ready."))
            return True
        else:
            log.append(("danger", f"✗ {lang_code} model FAILED (exit {proc.returncode})."))
            return False
    except Exception as e:
        log.append(("danger", f"✗ {lang_code} model error: {e}"))
        return False


# ── TUI ─────────────────────────────────────────────────────────────────
class OcrSetupTUI:
    MIN_H = 14
    MIN_W = 44

    def __init__(self, stdscr: curses.window):
        self.stdscr = stdscr
        self.config = read_config()
        ocr_cfg = self.config.get("ocr", {})
        self.installed = ocr_cfg.get("languages", [])
        self.default_lang = ocr_cfg.get("lang", "ch")
        self.selected = {c for c in self.installed if c in PADDLEOCR_CODES}
        if not self.selected:
            self.selected = {"ch"}
        if self.default_lang in PADDLEOCR_CODES:
            self.selected.add(self.default_lang)
        self.have_ocr = check_paddleocr()
        self.cursor = 0
        self.busy = False
        self.busy_log: list = []
        self.status_msg = ""
        self.status_tone = "ok"
        self._quit = False
        self._done_event = threading.Event()
        self._install_ok = [False]

    # ── lifecycle ──

    def run(self):
        self._init_curses()
        while not self._quit:
            self._draw()
            self._handle_input()

    def _init_curses(self):
        S.setup_locale()
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        curses.noecho()
        curses.cbreak()
        self.stdscr.keypad(True)
        S.init_colors()
        self.stdscr.timeout(150)

    # ── hero ──

    def _hero_info(self):
        title = "OCR Setup & Model Downloader"
        subtitle_parts = []
        subtitle_parts.append(
            "Installed" if self.have_ocr else "Not installed")
        subtitle_parts.append(f"Default: {self.default_lang}")
        extra = ""
        if self.busy:
            extra = "working..."
        elif self.status_msg:
            extra = self.status_msg
        if extra:
            subtitle_parts.append(extra)
        subtitle = " · ".join(subtitle_parts)
        status_text = ""
        tone = "muted"
        if self.busy:
            status_text = "Working..."
            tone = "warn"
        elif self.have_ocr:
            status_text = "Engine ready"
            tone = "ok"
        else:
            status_text = "Not installed"
            tone = "muted"
        msg = ""
        if self.busy:
            msg = "working..."
        elif self.status_msg:
            msg = self.status_msg
            tone = self.status_tone
        return S.hero_line(title, subtitle, tone, self.busy, msg, status_text)

    # ── background work ──

    def _start_work(self, force=False):
        self.busy_log.clear()
        self.busy = True
        self.status_msg = ""
        self._done_event.clear()
        lang_codes = sorted(self.selected)
        cfg = {"lang": self.default_lang, "languages": lang_codes, "engine": "onnxruntime"}

        def _work():
            log = self.busy_log
            self._install_ok[0] = True
            if force or not check_paddleocr():
                ok = run_pip_install(log, force=force)
            else:
                log.append("paddleocr package is already installed.")
                ok = True
            if ok:
                for code in lang_codes:
                    if code in PADDLEOCR_CODES:
                        if not download_model(code, log):
                            self._install_ok[0] = False
            log.append("")
            log.append("Saving config...")
            self.config["ocr"] = cfg
            r = write_config(self.config)
            if r is True:
                log.append(("ok", "Config saved to sumika.json"))
            else:
                log.append(("danger", f"WARNING: {r}"))
            self._done_event.set()

        t = threading.Thread(target=_work, daemon=True)
        t.start()

    # ── draw ──

    def _draw(self):
        h, w = self.stdscr.getmaxyx()
        self.stdscr.erase()

        if h < self.MIN_H or w < self.MIN_W:
            try:
                self.stdscr.addnstr(0, 0, f"Terminal too small (min {self.MIN_W}x{self.MIN_H})", w)
            except curses.error:
                pass
            self.stdscr.refresh()
            return

        # Check background completion
        if self.busy and self._done_event.is_set():
            self.busy = False
            self.have_ocr = check_paddleocr()
            if self._install_ok[0]:
                self.status_msg = "Installation & model downloads complete!"
                self.status_tone = "ok"
            else:
                self.status_msg = "Download process encountered issues."
                self.status_tone = "danger"

        margin = 1
        hero_h = 2

        # Layout
        n_langs = len(LANGUAGES)
        log_h = 6 if (self.busy or self.status_msg) else 0
        help_h = 2
        list_h = max(4, h - hero_h - log_h - help_h - margin * 2)

        # ── Hero ──
        S.draw_hero(self.stdscr, self._hero_info())

        # ── Language list panel ──
        y = margin + hero_h - 1
        box_w = w - margin * 2
        S.draw_focus_border(self.stdscr, True, y, margin, list_h, box_w, "Languages")
        self._draw_lang_list(y + 1, margin + 1, list_h - 2, box_w - 2)
        y += list_h

        # ── Log / status panel ──
        if log_h > 0:
            log_y = y
            if self.busy:
                S.draw_border(self.stdscr, log_y, margin, log_h, box_w, "Activity")
                S.draw_log_in_area(self.stdscr, log_y, margin, log_h, box_w,
                                   self.busy_log, empty_text="Starting...")
            elif self.status_msg:
                S.draw_border(self.stdscr, log_y, margin, log_h, box_w, "Status")
                ok = self.status_tone == "ok"
                attr = S.ATTR_OK if ok else S.ATTR_DANGER
                S.safe_addstr(
                    self.stdscr, log_y + 1, margin + 2,
                    S.truncate(self.status_msg, box_w - 4),
                    attr)
            y += log_h

        # ── Help bar ──
        if not self.busy:
            gen = [("arrows", "navigate"), ("q", "quit")]
            tool = [
                ("space", "toggle"), ("d", "default"),
                ("i", "install"), ("r", "reinstall"),
                ("s", "save"),
            ]
        else:
            gen = [("q", "cancel")]
            tool = [("wait..", "installing")]
        S.draw_help_bar(self.stdscr, gen, tool)

        S.finish_frame(self.stdscr)

    def _draw_lang_list(self, y, x, h, w):
        n = len(LANGUAGES)
        max_vis = min(n, h)
        scroll = max(0, min(self.cursor - max_vis + 1, n - max_vis))

        for i in range(scroll, min(scroll + max_vis, n)):
            code, native, eng = LANGUAGES[i]
            checked = code in self.selected
            is_def = code == self.default_lang
            trailing = "← default" if is_def else ""
            tag, text = S.toggle_line(
                checked, f"{native} ({eng})",
                focused=(i == self.cursor and not self.busy),
                trailing=trailing)
            attr = S.TAG_STYLE.get(tag, S.ATTR_TEXT)
            S.safe_addstr(self.stdscr, y + (i - scroll), x,
                          S.truncate(text, w), attr)

    # ── input ──

    def _handle_input(self):
        key = self.stdscr.getch()
        if key == -1:
            return

        if key in (ord("q"), ord("Q"), 27):
            self._quit = True
            return

        if self.busy:
            return

        n = len(LANGUAGES)

        if key in (ord("j"), ord("J"), curses.KEY_DOWN):
            if self.cursor < n - 1:
                self.cursor += 1
        elif key in (ord("k"), ord("K"), curses.KEY_UP):
            if self.cursor > 0:
                self.cursor -= 1
        elif key == ord(" "):
            code = LANGUAGES[self.cursor][0]
            if code in self.selected:
                self.selected.discard(code)
                if code == self.default_lang and self.selected:
                    self.default_lang = next(iter(self.selected))
            else:
                self.selected.add(code)
                self.default_lang = code
            self.status_msg = ""
        elif key in (ord("d"), ord("D"), 10, 13):
            code = LANGUAGES[self.cursor][0]
            self.selected.add(code)
            self.default_lang = code
            self.status_msg = f"Default: {code}"
            self.status_tone = "ok"
        elif key in (ord("i"), ord("I")):
            if not self.selected:
                self.status_msg = "Select at least one language."
                self.status_tone = "danger"
                return
            self._start_work(force=False)
        elif key in (ord("r"), ord("R")):
            if not self.selected:
                self.status_msg = "Select at least one language."
                self.status_tone = "danger"
                return
            self._start_work(force=True)
        elif key in (ord("s"), ord("S")):
            if not self.selected:
                self.status_msg = "Select at least one language."
                self.status_tone = "danger"
                return
            cfg = {
                "lang": self.default_lang,
                "languages": sorted(self.selected),
                "engine": "onnxruntime",
            }
            self.config["ocr"] = cfg
            err = write_config(self.config)
            if err is True:
                self.status_msg = f"✓ Config saved (Default: {self.default_lang})"
                self.status_tone = "ok"
            else:
                self.status_msg = f"✗ Config save failed: {err}"
                self.status_tone = "danger"


# ── entry ───────────────────────────────────────────────────────────────

def main():
    S.setup_locale()
    try:
        curses.wrapper(lambda stdscr: OcrSetupTUI(stdscr).run())
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
