#!/usr/bin/env python3
"""
OMD OCR Setup TUI — multi-language OCR installer and configurator.

Installs paddleocr + onnxruntime, downloads selected language models,
and writes the configuration to sumika.json.

Controls
  j / Down      Move selection down
  k / Up        Move selection up
  Space         Toggle language selection
  d / Enter     Set highlighted language as default
  i / I         Install selected languages + download models
  r / R         Force reinstall paddleocr + download models
  s / S         Save config only
  q / Esc       Quit
"""

import curses
import json
import locale
import os
import subprocess
import sys
import threading
import time

TRUNCATE: dict = {}


LANGUAGES = [
    ("ch",    "简体中文",   "Chinese (Simplified)"),
    ("en",    "English",    "English"),
    ("japan", "日本語",         "Japanese"),
    ("korean","한국어",          "Korean"),
    ("fr",    "Français",              "French"),
    ("de",    "Deutsch",    "German"),
    ("es",    "Español",              "Spanish"),
    ("pt",    "Português",             "Portuguese"),
    ("it",    "Italiano",   "Italian"),
    ("ru",    "Русский", "Russian"),
    ("ar",    "العربية", "Arabic"),
]
PADDLEOCR_CODES = {c for c, _, _ in LANGUAGES}


def _config_home():
    return os.environ.get("SUMIKA_SHELL_CONFIG_HOME") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
        "sumika-shell",
    )


def _sumika_json_path():
    return os.path.join(_config_home(), "sumika.json")


def read_config():
    path = _sumika_json_path()
    if not os.path.isfile(path):
        return {"ocr": {}}
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        if "ocr" not in data:
            data["ocr"] = {}
        return data
    except (json.JSONDecodeError, OSError):
        return {"ocr": {}}


def write_config(data):
    path = _sumika_json_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        return True
    except OSError as e:
        return str(e)


def check_paddleocr():
    try:
        import paddleocr  # noqa: F401
        return True
    except ImportError:
        return False


def run_pip_install(log, force=False):
    label = "Force reinstalling" if force else "Installing"
    log.append(f"{label} paddleocr + onnxruntime ...")
    cmd = [sys.executable, "-m", "pip", "install", "paddleocr", "onnxruntime"]
    if force:
        cmd.insert(4, "--force-reinstall")
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
        for line in iter(proc.stdout.readline, ""):
            line = line.rstrip()
            if line:
                log.append(line)
        proc.wait()
        if proc.returncode == 0:
            log.append(f"{'Reinstall' if force else 'Install'} complete.")
        else:
            log.append(f"pip install FAILED (exit {proc.returncode}).")
        return proc.returncode == 0
    except Exception as e:
        log.append(f"pip install error: {e}")
        return False


def download_model(lang_code, log):
    log.append(f"Downloading {lang_code} model ...")
    py_code = (
        "import os, sys; "
        "os.environ['PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK']='1'; "
        "os.environ['GLOG_minloglevel']='3'; "
        "from paddleocr import PaddleOCR; "
        f"PaddleOCR(lang='{lang_code}', engine='onnxruntime')"
    )
    cmd = [sys.executable, "-c", py_code]
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
        for line in iter(proc.stdout.readline, ""):
            line = line.rstrip()
            if line:
                log.append(f"  {line}")
        proc.wait()
        if proc.returncode == 0:
            log.append(f"✓ {lang_code} model ready.")
            return True
        else:
            log.append(f"✗ {lang_code} model FAILED (exit {proc.returncode}).")
            return False
    except Exception as e:
        log.append(f"✗ {lang_code} model error: {e}")
        return False


def _trunc(s, w):
    key = (s, w)
    if key not in TRUNCATE:
        TRUNCATE[key] = s if len(s) <= w else s[: max(1, w - 1)] + "…"
    return TRUNCATE[key]


def _safe_add(y, x, text, *attr):
    try:
        if attr:
            _safe_add._stdscr.addstr(y, x, text, *attr)
        else:
            _safe_add._stdscr.addstr(y, x, text)
    except curses.error:
        pass


def main(stdscr):
    curses.curs_set(0)
    _safe_add._stdscr = stdscr
    stdscr.timeout(100)  # Non-blocking input polling every 100ms
    curses.use_default_colors()
    try:
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        curses.init_pair(3, curses.COLOR_RED, -1)
        curses.init_pair(4, curses.COLOR_YELLOW, -1)
        curses.init_pair(5, curses.COLOR_WHITE, curses.COLOR_BLUE)
        curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_WHITE)
        curses.init_pair(7, curses.COLOR_WHITE, -1)
    except curses.error:
        pass

    A_ACCENT = curses.color_pair(1) | curses.A_BOLD
    A_OK = curses.color_pair(2) | curses.A_BOLD
    A_DANGER = curses.color_pair(3) | curses.A_BOLD
    A_SECTION = curses.color_pair(4) | curses.A_BOLD
    A_FOCUS = curses.color_pair(5)
    A_BTN = curses.color_pair(6) | curses.A_BOLD
    A_MUTED = curses.color_pair(7)
    A_CHECK_ON = A_OK
    A_CHECK_OFF = curses.A_DIM

    config = read_config()
    ocr_cfg = config.get("ocr", {})
    installed = ocr_cfg.get("languages", [])
    default_lang = ocr_cfg.get("lang", "ch")

    selected = {c for c in installed if c in PADDLEOCR_CODES}
    if not selected:
        selected = {"ch"}
    if default_lang in PADDLEOCR_CODES:
        selected.add(default_lang)

    have_ocr = check_paddleocr()
    cursor = 0
    busy = False
    busy_log = []
    status_msg = ""
    done_event = threading.Event()
    install_ok = [False]

    def _start_work(force=False):
        nonlocal busy, busy_log, status_msg, have_ocr
        busy_log.clear()
        busy = True
        done_event.clear()
        status_msg = ""
        lang_codes = sorted(selected)
        cfg = {"lang": default_lang, "languages": lang_codes, "engine": "onnxruntime"}

        def _work():
            log = busy_log
            install_ok[0] = True
            if force or not check_paddleocr():
                ok = run_pip_install(log, force=force)
            else:
                log.append("paddleocr package is already installed.")
                ok = True

            if ok:
                for code in lang_codes:
                    if code in PADDLEOCR_CODES:
                        if not download_model(code, log):
                            install_ok[0] = False
            log.append("")
            log.append("Saving config...")
            config["ocr"] = cfg
            r = write_config(config)
            if r is True:
                log.append("Config saved to sumika.json")
            else:
                log.append(f"WARNING: {r}")

        t = threading.Thread(target=_work, daemon=True)
        t.start()

    n = len(LANGUAGES)

    while True:
        key = stdscr.getch()

        # Poll background thread completion / idle redraw during install
        if key == -1:
            if busy and done_event.is_set():
                busy = False
                have_ocr = check_paddleocr()
                if install_ok[0]:
                    status_msg = "✓ Installation & model downloads complete!"
                else:
                    status_msg = "✗ Download process encountered issues."
                redraw = True
            elif busy:
                redraw = True
            continue

        # Process input
        if key in (ord("q"), ord("Q"), 27):
            break
        elif key in (ord("j"), ord("J"), curses.KEY_DOWN):
            if cursor < n - 1:
                cursor += 1
        elif key in (ord("k"), ord("K"), curses.KEY_UP):
            if cursor > 0:
                cursor -= 1
        elif key == ord(" "):
            code = LANGUAGES[cursor][0]
            if code in selected:
                selected.discard(code)
                if code == default_lang and selected:
                    default_lang = next(iter(selected))
            else:
                selected.add(code)
                default_lang = code
        elif key in (ord("d"), ord("D"), 10, 13):
            code = LANGUAGES[cursor][0]
            selected.add(code)
            default_lang = code
            status_msg = f"Set '{code}' as default language."
        elif key in (ord("i"), ord("I")) and not busy:
            if not selected:
                status_msg = "Select at least one language."
                redraw = True
                continue
            _start_work(force=False)
        elif key in (ord("r"), ord("R")) and not busy:
            if not selected:
                status_msg = "Select at least one language."
                redraw = True
                continue
            _start_work(force=True)
        elif key in (ord("s"), ord("S")) and not busy:
            if not selected:
                status_msg = "Select at least one language."
                redraw = True
                continue
            ocr_cfg["lang"] = default_lang
            ocr_cfg["languages"] = sorted(selected)
            ocr_cfg["engine"] = "onnxruntime"
            config["ocr"] = ocr_cfg
            err = write_config(config)
            if err is True:
                status_msg = f"✓ Config saved (Default: {default_lang}, Selected: {sorted(selected)})"
            else:
                status_msg = f"✗ Config save failed: {err}"

        redraw = True

        # ── Re-render after state change ──
        max_y, max_x = stdscr.getmaxyx()
        if max_y < 10 or max_x < 40:
            stdscr.clear()
            _safe_add(0, 0, "Terminal too small!")
            stdscr.refresh()
            continue

        stdscr.clear()

        # Header Title Bar
        header_str = " OCR Setup & Model Downloader "
        status_str = f"Engine: {'Installed' if have_ocr else 'Not Installed'}  |  Default: {default_lang} "
        _safe_add(0, 0, header_str, A_SECTION)
        if len(header_str) + len(status_str) < max_x:
            _safe_add(0, max_x - len(status_str) - 1, status_str, A_ACCENT)
        _safe_add(1, 0, "─" * max_x, curses.A_DIM)

        row = 2
        _safe_add(row, 1, "Select Languages (Space: toggle | d/Enter: set default):", A_MUTED)
        row += 1

        footer_h = 2
        log_h = 5 if busy or status_msg else 0
        lang_list_h = max(3, max_y - row - log_h - footer_h - 1)
        n = len(LANGUAGES)
        max_vis = min(n, lang_list_h)
        scroll = max(0, min(cursor - max_vis + 1, n - max_vis))

        for i in range(scroll, min(scroll + max_vis, n)):
            code, native, eng = LANGUAGES[i]
            checked = code in selected
            is_def = code == default_lang
            suffix = "  ← default" if is_def else ""
            if row >= max_y - log_h - footer_h - 1:
                break
            line_text = f"  [{'✓' if checked else ' '}] {native} ({eng}){suffix}"
            if i == cursor and not busy:
                _safe_add(row, 0, _trunc(line_text, max_x), A_FOCUS)
            else:
                chk_str = "[✓]" if checked else "[ ]"
                _safe_add(row, 2, chk_str, A_CHECK_ON if checked else A_CHECK_OFF)
                _safe_add(f" {native}", curses.A_BOLD if checked else A_MUTED)
                _safe_add(f" ({eng})", A_MUTED | curses.A_DIM if not checked else A_MUTED)
                if suffix:
                    _safe_add(suffix, curses.color_pair(2))
            row += 1

        if busy or status_msg:
            _safe_add(max_y - footer_h - log_h - 1, 0, "─" * max_x, curses.A_DIM)

        if busy:
            log_start_y = max_y - footer_h - log_h
            visible = busy_log[-log_h:]
            for idx, line in enumerate(visible):
                ly = log_start_y + idx
                if ly < max_y - footer_h:
                    _safe_add(ly, 1, _trunc(line, max_x - 2), A_MUTED)
        elif status_msg:
            ok = "✓" in status_msg or "saved" in status_msg or "complete" in status_msg
            _safe_add(max_y - footer_h - 2, 1, _trunc(status_msg, max_x - 2), A_OK if ok else A_DANGER)

        btn_y = max_y - 1
        bx = 1
        active = len(selected) > 0 and not busy
        buttons = [
            ("Space", "Toggle", not busy),
            ("d/Enter", "Default", not busy),
            ("i", "Install & Download", active),
            ("r", "Reinstall", not busy),
            ("s", "Save", active),
            ("q", "Quit", True),
        ]
        _safe_add(btn_y - 1, 0, "─" * max_x, curses.A_DIM)
        for key, label, en in buttons:
            attr = A_BTN if en else A_MUTED
            if bx + len(key) + len(label) + 4 < max_x:
                _safe_add(btn_y, bx, f"[{key}]", A_ACCENT if en else A_MUTED)
                _safe_add(f" {label} ", attr)
                bx += len(label) + len(key) + 4

        stdscr.refresh()



if __name__ == "__main__":
    locale.setlocale(locale.LC_ALL, "")
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        pass
